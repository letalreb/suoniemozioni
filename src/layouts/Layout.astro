---
import '../styles/global.css';
import { NOME, LUOGO, crediti, tutteLeSale, url } from '../lib/museo';
interface Props { title?: string; description?: string; sezione?: string; trasparente?: boolean }
const { title = `${NOME}, invito all’arte e alla musica a ${LUOGO}`, description = `Le ${tutteLeSale.length} sale di Villa Medici Giulini a Briosco: strumenti musicali, arredi e opere d’arte.`, sezione, trasparente = false } = Astro.props;
const voci = [['sale', 'Le sale', '/sale/'], ['strumenti', 'Strumenti', '/strumenti/'], ['teatrino', 'Teatrino', '/teatrino/'], ['giardino', 'Giardino', '/giardino/'], ['video', 'Video', '/video/']];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EDEFEA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141814" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:locale" content="it_IT" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..800;1,6..96,400..600&family=Hanken+Grotesk:wght@400;500;600&display=swap" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'con-hero': trasparente }}>
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <header class="testata">
      <a class="marchio" href={url('/')}>Suoni ed emozioni</a>
      <nav aria-label="Navigazione principale">
        {voci.map(([id, nome, path]) => <a href={url(path)} aria-current={sezione === id ? 'page' : undefined}>{nome}</a>)}
      </nav>
      <form class="vai-sala" data-vai-sala data-max={tutteLeSale.length} data-base={url('/sale/')}>
        <label for="vai-sala">Sala</label>
        <input id="vai-sala" type="number" inputmode="numeric" min="1" max={tutteLeSale.length} placeholder="n°" required />
        <button type="submit">Vai</button>
      </form>
    </header>
    <main id="contenuto"><slot /></main>
    <footer class="piede">
      <div>
        <p class="piede-nome">Suoni ed emozioni</p>
        <p>Villa Medici Giulini, via Medici 6, 20836 Briosco (MB)</p>
      </div>
      <p class="piede-crediti">{crediti}</p>
    </footer>
    <script>
      document.querySelectorAll<HTMLFormElement>('[data-vai-sala]').forEach((form) => {
        const input = form.querySelector('input')!;
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const n = Number(input.value), max = Number(form.dataset.max);
          if (!Number.isInteger(n) || n < 1 || n > max) {
            input.setCustomValidity(`Scrivi un numero da 1 a ${max}`); input.reportValidity(); return;
          }
          location.href = `${form.dataset.base}${n}/`;
        });
        input.addEventListener('input', () => input.setCustomValidity(''));
      });
    </script>
  </body>
</html>
