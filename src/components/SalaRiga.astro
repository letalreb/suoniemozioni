---
import { PIANI, linkSala, videoDellaSala, type Sala } from '../lib/museo';
interface Props { sala: Sala }
const { sala } = Astro.props;
const n = videoDellaSala(sala.numero).length;
---
<li class="sala-riga" data-sala data-piano={sala.piano} data-sezione={sala.sezione}
    data-testo={`${sala.numero} ${sala.titolo} ${sala.descrizione}`.toLocaleLowerCase('it')}>
  <a href={linkSala(sala.numero)}>
    <span class="sala-num">{sala.numero}</span>
    <span class="sala-titolo">{sala.titolo}</span>
    <span class="sala-info">
      {PIANI[sala.piano]}<span class="sep" aria-hidden="true">/</span>{n === 0 ? 'video in arrivo' : n === 1 ? '1 video' : `${n} video`}
    </span>
  </a>
</li>
