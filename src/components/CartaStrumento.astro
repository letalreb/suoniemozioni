---
import { SITO_ASCOLTO, asset, salaPer, type Strumento } from '../lib/museo';
import { t, percorso, titoloSala, nomeStrumento, type Lingua } from '../lib/i18n';
interface Props { s: Strumento; mostraSala?: boolean; lang?: Lingua }
const { s, mostraSala = true, lang = 'it' } = Astro.props;
const sala = salaPer(s.sala); const T = t(lang);
---
<article class="strumento">
  <div class="strumento-foto">
    {s.foto ? <img src={asset(s.foto)} alt="" loading="lazy" decoding="async" /> : <span class="strumento-n" aria-hidden="true">{s.numero}</span>}
  </div>
  <div class="strumento-testo">
    <h3><span class="strumento-cat">N. {s.numero}</span> {nomeStrumento(s.nome, lang)}</h3>
    {mostraSala && sala && <p><a href={percorso(lang, `/sale/${sala.numero}/`)}>{T.sala} {sala.numero}, {titoloSala(sala, lang)}</a></p>}
    {s.ascolto && <a class="ascolta" href={SITO_ASCOLTO} target="_blank" rel="noopener">{T.ascoltaStrumento}</a>}
  </div>
</article>
