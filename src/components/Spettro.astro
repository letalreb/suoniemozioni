---
// Le sale come barre di uno spettro sonoro, nell'ordine di visita.
// Il colore indica la sezione; le barre piene sono le sale con video.
import { linkSala, sezionePer, stileSezione, videoDellaSala, type Sala } from '../lib/museo';

interface Props {
  sale: Sala[];
  attiva?: number;
  compatto?: boolean;
  etichetta?: string;
}
const { sale, attiva, compatto = false, etichetta = 'Le sale in ordine di visita' } = Astro.props;

// Altezza deterministica a forma d'onda: motivo visivo, non un dato.
const altezza = (n: number) =>
  Math.round(28 + 72 * Math.abs(Math.sin(n * 0.52) * 0.7 + Math.sin(n * 0.19 + 1) * 0.3));
---
<div class:list={['spettro', { compatto }]} data-spettro>
  <ol class="spettro-barre" aria-label={etichetta}>
    {sale.map((s, i) => {
      const sez = sezionePer(s.sezione);
      const conVideo = videoDellaSala(s.numero).length > 0;
      return (
        <li style={`${stileSezione(sez)};--h:${altezza(s.numero)}%;--i:${i}`}>
          <a
            href={linkSala(s.numero)}
            class:list={['barra', { vuota: !conVideo, attiva: s.numero === attiva }]}
            aria-current={s.numero === attiva ? 'page' : undefined}
            data-didascalia={`Sala ${s.numero}, ${s.titolo}`}
          >
            <span class="sr-only">Sala {s.numero}: {s.titolo}</span>
          </a>
        </li>
      );
    })}
  </ol>
  {!compatto && (
    <p class="spettro-didascalia" aria-live="polite" data-didascalia-out>
      Tocca una barra per aprire la sala
    </p>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-spettro]').forEach((el) => {
    const out = el.querySelector<HTMLElement>('[data-didascalia-out]');
    if (!out) return;
    const iniziale = out.textContent;
    el.querySelectorAll<HTMLAnchorElement>('.barra').forEach((a) => {
      const mostra = () => (out.textContent = a.dataset.didascalia ?? '');
      a.addEventListener('mouseenter', mostra);
      a.addEventListener('focus', mostra);
    });
    el.addEventListener('mouseleave', () => (out.textContent = iniziale));
  });
</script>
