---
import { asset, linkSala, sezionePer, stileSezione, type Sala } from '../lib/museo';
interface Props { sala: Sala; carica?: 'lazy' | 'eager' }
const { sala, carica = 'lazy' } = Astro.props;
const sez = sezionePer(sala.sezione);
---
<a class="carta" href={linkSala(sala.numero)} style={stileSezione(sez)} data-carta>
  {sala.foto
    ? <img src={asset(sala.foto.heroSmall)} alt="" loading={carica} decoding="async" />
    : <span class="carta-vuota" aria-hidden="true"></span>}
  <span class="carta-num" aria-hidden="true">{sala.numero}</span>
  <span class="carta-tit"><span class="sr-only">Sala {sala.numero}: </span>{sala.titolo}</span>
</a>
