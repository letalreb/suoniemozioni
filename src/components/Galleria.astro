---
import { asset } from '../lib/museo';
import { t, type Lingua } from '../lib/i18n';
interface Props { foto: { src: string; thumb: string; w: number; h: number; pagina: number }[]; titolo: string; lang?: Lingua }
const { foto, titolo, lang = 'it' } = Astro.props; const T = t(lang);
---
{foto.length > 0 && (
  <div class="galleria" data-galleria>
    {foto.map((f, i) => (
      <button type="button" class="galleria-voce" data-i={i} data-src={asset(f.src)} data-didascalia={`${titolo}. ${T.dalVolume}, p. ${f.pagina}`}
        style={`aspect-ratio:${f.w}/${f.h}`} aria-label={T.ingrandisci(i + 1, foto.length)}>
        <img src={asset(f.thumb)} alt="" loading="lazy" decoding="async" />
      </button>
    ))}
    <dialog class="lightbox" aria-label={T.ingrandita}>
      <figure><img alt="" /><figcaption></figcaption></figure>
      <button type="button" class="lb-chiudi" data-chiudi>{T.chiudi}</button>
      <button type="button" class="lb-prec" data-passo="-1" aria-label={T.fotoPrec}>‹</button>
      <button type="button" class="lb-succ" data-passo="1" aria-label={T.fotoSucc}>›</button>
    </dialog>
  </div>
)}
<script>
  document.querySelectorAll<HTMLElement>('[data-galleria]').forEach((g) => {
    const voci = [...g.querySelectorAll<HTMLButtonElement>('.galleria-voce')];
    const dlg = g.querySelector('dialog')!, img = dlg.querySelector('img')!, cap = dlg.querySelector('figcaption')!;
    let i = 0;
    const mostra = (k: number) => { i = (k + voci.length) % voci.length; img.src = voci[i].dataset.src!; cap.textContent = voci[i].dataset.didascalia!; };
    voci.forEach((v, k) => v.addEventListener('click', () => { mostra(k); dlg.showModal(); }));
    dlg.querySelector('[data-chiudi]')!.addEventListener('click', () => dlg.close());
    dlg.querySelectorAll<HTMLButtonElement>('[data-passo]').forEach((b) => b.addEventListener('click', () => mostra(i + Number(b.dataset.passo))));
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') mostra(i + 1); if (e.key === 'ArrowLeft') mostra(i - 1); });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => voci[i].focus());
  });
</script>
