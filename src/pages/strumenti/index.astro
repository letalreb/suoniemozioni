---
import Layout from '../../layouts/Layout.astro';
import CartaStrumento from '../../components/CartaStrumento.astro';
import { NOME, SITO_ASCOLTO, tuttiGliStrumenti } from '../../lib/museo';
const n = tuttiGliStrumenti.length, ascolto = tuttiGliStrumenti.filter((s) => s.ascolto).length;
---
<Layout title={`Strumenti | ${NOME}`} sezione="strumenti">
  <header class="pagina-testa">
    <h1>La collezione di strumenti</h1>
    <p class="lead">Cembali, spinette, fortepiani, pianoforti, organi, arpe e salteri dal Seicento al Novecento. {ascolto} strumenti si possono ascoltare sul sito <a href={SITO_ASCOLTO} target="_blank" rel="noopener">Alla ricerca dei suoni perduti</a>, anche in confronto con un pianoforte Steinway.</p>
    <div class="filtri">
      <label class="cerca"><span class="sr-only">Cerca uno strumento</span><input id="cerca-str" type="search" placeholder="Cerca per costruttore, città o tipo" autocomplete="off" /></label>
      <label class="interruttore"><input type="checkbox" id="solo-ascolto" /> <span>Solo quelli da ascoltare</span></label>
    </div>
    <p class="conteggio" id="conteggio" aria-live="polite">{n} strumenti</p>
  </header>
  <div class="griglia-strumenti ampia">{tuttiGliStrumenti.map((s) => <CartaStrumento s={s} />)}</div>
  <p class="vuoto" id="vuoto" hidden>Nessuno strumento corrisponde alla ricerca. Prova con il nome del costruttore o con la città.</p>
</Layout>
<script>
  const c = document.querySelector<HTMLInputElement>('#cerca-str')!, a = document.querySelector<HTMLInputElement>('#solo-ascolto')!;
  const voci = [...document.querySelectorAll<HTMLElement>('[data-strumento]')], cont = document.querySelector('#conteggio')!, vuoto = document.querySelector<HTMLElement>('#vuoto')!;
  const f = () => { const t = c.value.trim().toLocaleLowerCase('it'); let n = 0;
    voci.forEach((v) => { const ok = (!t || v.dataset.testo!.includes(t)) && (!a.checked || v.dataset.ascolto); v.hidden = !ok; if (ok) n++; });
    cont.textContent = n === 1 ? '1 strumento' : `${n} strumenti`; vuoto.hidden = n > 0; };
  c.addEventListener('input', f); a.addEventListener('change', f);
</script>
