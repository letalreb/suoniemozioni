---
import Layout from '../../layouts/Layout.astro';
import { NOME_MUSEO, linkSala, salaPer, sezionePer, stileSezione, tuttiIVideo, url, type Video } from '../../lib/museo';

export function getStaticPaths() {
  return tuttiIVideo.map((video) => ({ params: { slug: video.slug }, props: { video } }));
}
const { video } = Astro.props as { video: Video };
const sala = salaPer(video.sala);
const stile = sala ? stileSezione(sezionePer(sala.sezione)) : undefined;
---
<Layout title={`${video.title} | ${NOME_MUSEO}`} description={video.description} sezione="video">
  <article class="video-dettaglio" style={stile}>
    {sala ? (
      <a class="indietro" href={linkSala(sala.numero)}>Torna alla sala {sala.numero}, {sala.titolo}</a>
    ) : (
      <a class="indietro" href={url('/video/')}>Torna ai video</a>
    )}
    <h1>{video.title}</h1>
    <p class="lead">{video.description}</p>

    <div class="player">
      <iframe src={video.videoUrl} title={video.title} loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen></iframe>
    </div>

    <dl class="metadati">
      {sala && <div><dt>Sala</dt><dd><a href={linkSala(sala.numero)}>{sala.numero}, {sala.titolo}</a></dd></div>}
      {video.duration && <div><dt>Durata</dt><dd>{video.duration}</dd></div>}
      {video.language && <div><dt>Lingua</dt><dd>{video.language.toUpperCase()}</dd></div>}
      {video.year && <div><dt>Anno</dt><dd>{video.year}</dd></div>}
    </dl>
    {video.tags?.length > 0 && <ul class="tag">{video.tags.map((t) => <li>{t}</li>)}</ul>}
  </article>
</Layout>
