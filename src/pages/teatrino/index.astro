---
import Layout from '../../layouts/Layout.astro';
import Galleria from '../../components/Galleria.astro';
import { NOME, TITOLO_LIBRO, asset, fotoSpeciali } from '../../lib/museo';
const f = fotoSpeciali['teatrino']!;
const testi = fotoSpeciali.testi['teatrino'] ?? [];
---
<Layout title={`Il Teatrino | ${NOME}`} description="Il cuore della fiaba musicale di Villa Giulini, dove gli strumenti storici incontrano il pubblico." sezione="teatrino" trasparente>
  <article class="sala speciale">
    <header class="sala-hero">
      <img src={asset(f.hero)} alt="" width={f.w} height={f.h} fetchpriority="high" />
      <div class="sala-hero-testo"><div><h1>Il Teatrino</h1><p class="sala-en" lang="en">The Teatrino</p></div></div>
    </header>
    <div class="sala-corpo">
      <p class="sala-intro">Il cuore della fiaba musicale di Villa Giulini, dove gli strumenti storici incontrano il pubblico.</p>
      <div class="testo-lungo">{testi.map((t) => <p>{t}</p>)}</div>
      <p class="didascalia">Testo e fotografie dal volume {TITOLO_LIBRO}.</p>
      <section class="sezione-sala" aria-labelledby="t-gal"><h2 id="t-gal">Fotografie</h2><Galleria foto={f.galleria} titolo="Il Teatrino" /></section>
    </div>
  </article>
</Layout>
