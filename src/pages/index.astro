---
import Layout from '../layouts/Layout.astro';
import Spettro from '../components/Spettro.astro';
import VideoCard from '../components/VideoCard.astro';
import {
  NOME_MUSEO, linkSala, saleDellaSezione, stileSezione, tutteLeSale, tutteLeSezioni, tuttiIVideo, url
} from '../lib/museo';

const recenti = [...tuttiIVideo].sort((a, b) => (b.year ?? 0) - (a.year ?? 0)).slice(0, 3);
---
<Layout sezione="home">
  <section class="apertura">
    <h1>Cinquanta sale da ascoltare</h1>
    <p class="lead">
      {NOME_MUSEO} è un percorso in {tutteLeSale.length} sale su tre piani. Per ogni sala trovi
      testi e video da guardare durante la visita o da casa.
    </p>
    <Spettro sale={tutteLeSale} />
  </section>

  <section class="blocco" aria-labelledby="t-sezioni">
    <h2 id="t-sezioni">Il percorso</h2>
    <ol class="sezioni">
      {tutteLeSezioni.map((sez) => {
        const sale = saleDellaSezione(sez.id);
        const primo = sale[0].numero, ultimo = sale[sale.length - 1].numero;
        return (
          <li class="sezione" style={stileSezione(sez)}>
            <a href={url(`/sale/#${sez.id}`)}>
              <span class="sezione-range">Sale {primo}–{ultimo}</span>
              <span class="sezione-nome">{sez.nome}</span>
              <span class="sezione-desc">{sez.descrizione}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="blocco visita" aria-labelledby="t-visita">
    <h2 id="t-visita">Sei nel museo?</h2>
    <p>
      Ogni sala ha un cartello con il suo numero e un codice QR. Inquadra il codice, oppure scrivi il
      numero in alto nella casella <strong>Sala n°</strong>. Per iniziare dalla prima:
      <a href={linkSala(1)}>apri la sala 1</a>.
    </p>
  </section>

  {recenti.length > 0 && (
    <section class="blocco" aria-labelledby="t-video">
      <div class="blocco-testa">
        <h2 id="t-video">Video</h2>
        <a href={url('/video/')}>Vedi tutti i {tuttiIVideo.length} video</a>
      </div>
      <div class="griglia-video">
        {recenti.map((v) => <VideoCard video={v} />)}
      </div>
    </section>
  )}
</Layout>
