---
import Layout from '../layouts/Layout.astro';
import CartaSala from '../components/CartaSala.astro';
import { TITOLO_LIBRO, asset, fotoSpeciali, saleDellaSezione, stileSezione, tutteLeSale, tutteLeSezioni, url } from '../lib/museo';
const intro = fotoSpeciali.intro!;
const teatrino = fotoSpeciali.teatrino!, giardino = fotoSpeciali.giardino!;
---
<Layout sezione="home" trasparente>
  <section class="copertina">
    <img src={asset(intro.hero)} alt="La facciata di Villa Giulini oltre il giardino all’italiana" width={intro.w} height={intro.h} fetchpriority="high" />
    <div class="copertina-testo">
      <h1>{TITOLO_LIBRO}</h1>
      <p>Invito all’arte e alla musica a Villa Medici Giulini, Briosco. Cinquanta sale dove gli strumenti della collezione abitano tra dipinti, porcellane, lumiere e arredi.</p>
    </div>
  </section>

  <section class="percorso" aria-labelledby="t-percorso">
    <div class="percorso-testa">
      <h2 id="t-percorso">Il percorso, sala per sala</h2>
      <p>Le sale si susseguono in ordine numerico, in senso orario, come nel volume. Scorri per sfogliarle.</p>
      <div class="percorso-frecce">
        <button type="button" data-scorri="-1" aria-label="Sale precedenti">‹</button>
        <button type="button" data-scorri="1" aria-label="Sale successive">›</button>
      </div>
    </div>
    <ol class="striscia" data-striscia>
      {tutteLeSale.map((s, i) => <li><CartaSala sala={s} carica={i < 6 ? 'eager' : 'lazy'} /></li>)}
    </ol>
  </section>

  <section class="blocco" aria-labelledby="t-edifici">
    <h2 id="t-edifici">Cinque luoghi della dimora</h2>
    <ul class="edifici">
      {tutteLeSezioni.map((sez) => {
        const ss = saleDellaSezione(sez.id); const a = ss[0].numero, b = ss[ss.length - 1].numero;
        return (
          <li style={stileSezione(sez)}>
            <a href={url(`/sale/#${sez.id}`)}>
              <span class="edificio-range">{a === b ? `Sala ${a}` : `Sale ${a}–${b}`}</span>
              <span class="edificio-nome">{sez.nome}</span>
              <span class="edificio-desc">{sez.descrizione}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>


  <section class="dittico" aria-label="Il Teatrino e il giardino">
    <a href={url('/teatrino/')} class="pannello">
      <img src={asset(teatrino.heroSmall)} alt="" loading="lazy" />
      <span><strong>Il Teatrino</strong>Il punto finale dell’itinerario nel mondo della musica.</span>
    </a>
    <a href={url('/giardino/')} class="pannello">
      <img src={asset(giardino.heroSmall)} alt="" loading="lazy" />
      <span><strong>Il giardino incantato</strong>Fioriture, colori d’autunno e musica all’aperto.</span>
    </a>
  </section>
</Layout>
<script>
  const s = document.querySelector<HTMLElement>('[data-striscia]')!;
  document.querySelectorAll<HTMLButtonElement>('[data-scorri]').forEach((b) =>
    b.addEventListener('click', () => s.scrollBy({ left: Number(b.dataset.scorri) * s.clientWidth * 0.8, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })));
</script>
