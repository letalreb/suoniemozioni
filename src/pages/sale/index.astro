---
import Layout from '../../layouts/Layout.astro';
import CartaSala from '../../components/CartaSala.astro';
import { NOME, saleDellaSezione, stileSezione, tutteLeSale, tutteLeSezioni } from '../../lib/museo';
---
<Layout title={`Le sale | ${NOME}`} sezione="sale">
  <header class="pagina-testa">
    <h1>Le {tutteLeSale.length} sale</h1>
    <p class="lead">Nell’ordine della visita, divise per edificio. Il numero è lo stesso del cartello in sala e delle planimetrie del volume.</p>
    <label class="cerca"><span class="sr-only">Cerca una sala</span>
      <input id="cerca-sala" type="search" placeholder="Cerca per nome, per esempio organo o camera" autocomplete="off" />
    </label>
    <p class="conteggio" id="conteggio" aria-live="polite"></p>
  </header>
  {tutteLeSezioni.map((sez) => (
    <section class="gruppo" id={sez.id} style={stileSezione(sez)} data-gruppo>
      <div class="gruppo-testa"><h2>{sez.nome}</h2><p>{sez.descrizione}</p></div>
      <ol class="griglia-sale">
        {saleDellaSezione(sez.id).map((s) => <li data-voce data-testo={`${s.numero} ${s.titolo} ${s.titoloEn} ${s.piano} ${s.descrizione}`.toLocaleLowerCase('it')}><CartaSala sala={s} /></li>)}
      </ol>
    </section>
  ))}
  <p class="vuoto" id="vuoto" hidden>Nessuna sala corrisponde alla ricerca. Prova con un’altra parola, oppure scrivi il numero nella casella Sala in alto.</p>
</Layout>
<script>
  const c = document.querySelector<HTMLInputElement>('#cerca-sala')!, voci = [...document.querySelectorAll<HTMLElement>('[data-voce]')];
  const gruppi = [...document.querySelectorAll<HTMLElement>('[data-gruppo]')], cont = document.querySelector('#conteggio')!, vuoto = document.querySelector<HTMLElement>('#vuoto')!;
  c.addEventListener('input', () => {
    const t = c.value.trim().toLocaleLowerCase('it'); let n = 0;
    voci.forEach((v) => { const ok = !t || v.dataset.testo!.includes(t); v.hidden = !ok; if (ok) n++; });
    gruppi.forEach((g) => (g.hidden = !g.querySelector('[data-voce]:not([hidden])')));
    cont.textContent = t ? (n === 1 ? '1 sala trovata' : `${n} sale trovate`) : ''; vuoto.hidden = n > 0;
  });
</script>
